{
  "name": "@vspark/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build-migrations": "node scripts/buildMigrations.mjs",
    "predev": "node scripts/buildMigrations.mjs",
    "prebuild": "node scripts/buildMigrations.mjs",
    "prelint": "node scripts/buildMigrations.mjs",
    "prebundle": "node scripts/buildMigrations.mjs",
    "pretest": "node scripts/buildMigrations.mjs",
    "dev": "tsx watch src/index.ts",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "build": "tsc && node scripts/buildFeedPreview.mjs",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "bundle": "node bundle.mjs"
  },
  "bin": {
    "vspark-mcp": "dist/mcp-stdio.cjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@overlive/core": "^0.1.0",
    "@overlive/emotes": "^0.1.0",
    "@overlive/se": "^0.1.0",
    "@overlive/twitch": "^0.1.0",
    "@overlive/twitch-oauth": "^0.1.0",
    "@vspark/mesh": "workspace:*",
    "@vspark/mesh-transports": "workspace:*",
    "@vspark/shared": "workspace:*",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "htm": "^3.1.1",
    "node-sqlite3-wasm": "^0.8.57",
    "open": "^10.2.0",
    "playwright-core": "^1.61.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "werift": "^0.23.0",
    "ws": "^8.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-istanbul": "^3.2.6",
    "esbuild": "^0.28.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
